logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "backend_logs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/travel-planner/travel-planner.log",
    environment = "prod",
    service     = "travel-planner-backend",
  }]
}

loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_logs.receiver]
}

loki.process "backend_logs" {
  stage.json {
    expressions = {
      level = "log.level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
