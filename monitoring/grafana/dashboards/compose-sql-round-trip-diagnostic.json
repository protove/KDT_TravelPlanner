{
  "uid": "compose-sql-round-trip-diagnostic",
  "title": "Compose SQL Round-trip Diagnostic — SCRUM-41",
  "description": "Diagnostic-only dashboard for the fixed cardinality/no-op/reverse Compose experiment. It is not an AWS or production SLO dashboard.",
  "tags": ["SCRUM-41", "compose", "sql", "pg_stat_statements", "diagnostic"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "5s",
  "annotations": {"list": [{"name": "SQL diagnostic annotations", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": false, "iconColor": "#5794F2", "type": "dashboard"}]},
  "templating": {
    "list": [
      {"name": "replicate", "label": "Replicate", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(scrum41_sql_diagnostic_api_duration_ms, replicate)", "includeAll": true, "multi": true, "refresh": 2, "current": {"text": "All", "value": ["$__all"]}},
      {"name": "mode", "label": "Mode", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(scrum41_sql_diagnostic_api_duration_ms, mode)", "includeAll": true, "multi": true, "refresh": 2, "current": {"text": "All", "value": ["$__all"]}},
      {"name": "item_count", "label": "Item count", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(scrum41_sql_diagnostic_api_duration_ms, item_count)", "includeAll": true, "multi": true, "refresh": 2, "current": {"text": "All", "value": ["$__all"]}},
      {"name": "query_family", "label": "Query family", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(scrum41_sql_diagnostic_sql_calls_per_request, query_family)", "includeAll": true, "multi": true, "refresh": 2, "current": {"text": "All", "value": ["$__all"]}}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Targets up", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(up{job=~\"backend|postgres|redis|pushgateway|prometheus|loki|alloy\"})", "legendFormat": "up"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}},
    {"id": 2, "type": "timeseries", "title": "API p95 by mode and item count", "gridPos": {"x": 6, "y": 0, "w": 18, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "scrum41_sql_diagnostic_api_duration_ms{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",statistic=\"p95\"}", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 3, "type": "timeseries", "title": "SQL calls per request", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (replicate, mode, item_count) (scrum41_sql_diagnostic_sql_calls_per_request{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",query_family=~\"$query_family\",statistic=\"median\"})", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 4, "type": "timeseries", "title": "Timeline UPDATE calls per request", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (replicate, mode, item_count) (scrum41_sql_diagnostic_sql_calls_per_request{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",query_family=\"timeline_update\",statistic=\"median\"})", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "type": "timeseries", "title": "DB execution time per request", "gridPos": {"x": 0, "y": 10, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (replicate, mode, item_count) (scrum41_sql_diagnostic_db_exec_ms_per_request{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",query_family=~\"$query_family\",statistic=\"median\"})", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Mean DB execution time per call", "gridPos": {"x": 12, "y": 10, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (replicate, mode, item_count) (scrum41_sql_diagnostic_db_mean_exec_ms_per_call{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",query_family=~\"$query_family\",statistic=\"median\"})", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "SQL update amplification", "gridPos": {"x": 0, "y": 15, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "scrum41_sql_diagnostic_update_amplification{replicate=~\"$replicate\",mode=~\"$mode\",item_count=~\"$item_count\",statistic=\"median\"}", "legendFormat": "r{{replicate}} {{mode}} n={{item_count}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "Request body bytes (p95)", "gridPos": {"x": 8, "y": 15, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "k6_sql_diagnostic_request_body_bytes_p95{flow=\"sql-round-trip-diagnostic\",sql_diagnostic_mode=~\"$mode\",sql_diagnostic_item_count=~\"$item_count\"}", "legendFormat": "{{sql_diagnostic_mode}} n={{sql_diagnostic_item_count}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "stat", "title": "Contract failure rate", "gridPos": {"x": 16, "y": 15, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "100 * max(k6_sql_diagnostic_contract_failures_rate{flow=\"sql-round-trip-diagnostic\",sql_diagnostic_mode=~\"$mode\"})", "legendFormat": "failure %"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 3}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}},
    {"id": 10, "type": "timeseries", "title": "PostgreSQL locks and deadlocks", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(pg_locks_count{job=\"postgres\"})", "legendFormat": "locks"}, {"refId": "B", "expr": "rate(pg_stat_database_deadlocks{job=\"postgres\"}[1m])", "legendFormat": "deadlocks/s"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 11, "type": "timeseries", "title": "PostgreSQL I/O and WAL", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(pg_stat_database_blks_read{job=\"postgres\"}[1m])", "legendFormat": "blocks read/s"}, {"refId": "B", "expr": "rate(pg_stat_database_temp_files{job=\"postgres\"}[1m])", "legendFormat": "temp files/s"}, {"refId": "C", "expr": "rate(pg_stat_wal_records{job=\"postgres\"}[1m])", "legendFormat": "WAL records/s"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 12, "type": "timeseries", "title": "Hikari active / pending", "gridPos": {"x": 0, "y": 25, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"backend\"}", "legendFormat": "active"}, {"refId": "B", "expr": "hikaricp_connections_pending{job=\"backend\"}", "legendFormat": "pending"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 13, "type": "stat", "title": "pg_stat_statements collector", "gridPos": {"x": 12, "y": 25, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "min(pg_stat_statements_calls{job=\"postgres\"}) >= 0", "legendFormat": "collector"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}},
    {"id": 14, "type": "stat", "title": "Redis health control", "gridPos": {"x": 18, "y": 25, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "min(redis_up{job=\"redis\"})", "legendFormat": "redis up"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}}
  ]
}
