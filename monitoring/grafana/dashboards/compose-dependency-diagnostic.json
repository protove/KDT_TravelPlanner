{
  "uid": "compose-dependency-diagnostic",
  "title": "Compose Dependency Diagnostic — SCRUM-41",
  "description": "Diagnostic-only dashboard for controlled Compose workload comparison. It is not an AWS SLO dashboard.",
  "tags": ["SCRUM-41", "compose", "diagnostic", "postgres", "redis", "k6"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "annotations": {
    "list": [
      {
        "name": "Diagnostic run annotations",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": false,
        "iconColor": "#5794F2",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "variant",
        "label": "Variant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_http_req_duration_p95, diagnostic_variant)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "operation",
        "label": "Operation",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_http_req_duration_p95, diagnostic_operation)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=~\"backend|postgres|redis|prometheus|loki|alloy\"})", "legendFormat": "up" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "k6 request rate",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (diagnostic_variant, diagnostic_operation) (rate(k6_http_reqs_total{diagnostic_variant=~\"$variant\",diagnostic_operation=~\"$operation\"}[1m]))", "legendFormat": "{{diagnostic_variant}} / {{diagnostic_operation}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "k6 HTTP p95 duration",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "1000 * max by (diagnostic_variant, diagnostic_operation) (k6_http_req_duration_p95{diagnostic_variant=~\"$variant\",diagnostic_operation=~\"$operation\"})", "legendFormat": "{{diagnostic_variant}} / {{diagnostic_operation}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reorder duration by route",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri=~\".*/timeline-items/order\"}[1m]))) * 1000", "legendFormat": "{{uri}} p95" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reorder item count",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (diagnostic_variant, diagnostic_operation, diagnostic_item_count_bucket) (k6_diagnostic_reorder_item_count{diagnostic_variant=~\"$variant\"})", "legendFormat": "{{diagnostic_variant}} {{diagnostic_item_count_bucket}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hikari active / pending",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"backend\"}", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_pending{job=\"backend\"}", "legendFormat": "pending" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL transactions",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\"}[1m])", "legendFormat": "commit/s" },
        { "refId": "B", "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\"}[1m])", "legendFormat": "rollback/s" },
        { "refId": "C", "expr": "rate(pg_stat_database_deadlocks{job=\"postgres\"}[1m])", "legendFormat": "deadlocks/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PostgreSQL buffer hit ratio",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * rate(pg_stat_database_blks_hit{job=\"postgres\"}[1m]) / clamp_min(rate(pg_stat_database_blks_hit{job=\"postgres\"}[1m]) + rate(pg_stat_database_blks_read{job=\"postgres\"}[1m]), 1)", "legendFormat": "{{datname}} hit %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis clients / memory",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "redis_connected_clients{job=\"redis\"}", "legendFormat": "clients" },
        { "refId": "B", "expr": "redis_memory_used_bytes{job=\"redis\"}", "legendFormat": "memory" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis cache hits / misses / evictions",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[1m])", "legendFormat": "hits/s" },
        { "refId": "B", "expr": "rate(redis_keyspace_misses_total{job=\"redis\"}[1m])", "legendFormat": "misses/s" },
        { "refId": "C", "expr": "rate(redis_evicted_keys_total{job=\"redis\"}[1m])", "legendFormat": "evictions/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Backend CPU / JVM heap",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{job=\"backend\"} * 100", "legendFormat": "process CPU %" },
        { "refId": "B", "expr": "sum(jvm_memory_used_bytes{job=\"backend\",area=\"heap\"})", "legendFormat": "heap used" },
        { "refId": "C", "expr": "rate(jvm_gc_pause_seconds_sum{job=\"backend\"}[1m])", "legendFormat": "GC pause/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Exporter health",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "min(pg_up{job=\"postgres\"})", "legendFormat": "postgres" },
        { "refId": "B", "expr": "min(redis_up{job=\"redis\"})", "legendFormat": "redis" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Request body bytes",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (diagnostic_variant, diagnostic_operation) (k6_diagnostic_request_body_bytes{diagnostic_variant=~\"$variant\",diagnostic_operation=~\"$operation\"})", "legendFormat": "{{diagnostic_variant}} / {{diagnostic_operation}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Diagnostic contract failure rate",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * max(k6_diagnostic_contract_failures{diagnostic_variant=~\"$variant\"})", "legendFormat": "failure %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 3 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    }
  ]
}
