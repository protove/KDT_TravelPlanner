{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "#5794F2",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "loki", "uid": "loki" },
        "enable": true,
        "expr": "{service=\"travel-planner-backend\"} |= \"load-test\"",
        "iconColor": "#F2495C",
        "name": "EKS load-test events",
        "type": "tags"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kube-state-metrics Pod phase series for the selected namespace.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"})", "legendFormat": "running pods", "refId": "A" },
        { "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Pending\"})", "legendFormat": "pending pods", "refId": "B" },
        { "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Failed\"})", "legendFormat": "failed pods", "refId": "C" }
      ],
      "title": "Pod phase by namespace",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kube-state-metrics Deployment desired, available and unavailable replicas.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(kube_deployment_spec_replicas{namespace=~\"$namespace\"})", "legendFormat": "desired replicas", "refId": "A" },
        { "expr": "sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\"})", "legendFormat": "available replicas", "refId": "B" },
        { "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=~\"$namespace\"})", "legendFormat": "unavailable replicas", "refId": "C" }
      ],
      "title": "Deployment availability",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HPA decisions are separate from observed Pod and node placement.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(kube_horizontalpodautoscaler_status_desired_replicas{namespace=~\"$namespace\"})", "legendFormat": "HPA desired", "refId": "A" },
        { "expr": "sum(kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\"})", "legendFormat": "HPA current", "refId": "B" },
        { "expr": "sum(kube_horizontalpodautoscaler_spec_max_replicas{namespace=~\"$namespace\"})", "legendFormat": "HPA max", "refId": "C" }
      ],
      "title": "Backend HPA desired / current / max",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kube-state-metrics Ready condition shows node-level scale-out capacity.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "legendFormat": "ready nodes", "refId": "A" },
        { "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"false\"})", "legendFormat": "not-ready nodes", "refId": "B" }
      ],
      "title": "Ready node count",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pending Pods are the scheduling-pressure signal; an idle run may legitimately have no reason series.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Pending\"})", "legendFormat": "pending pods", "refId": "A" },
        { "expr": "sum(kube_pod_status_reason{namespace=~\"$namespace\",reason=~\"Unschedulable|FailedScheduling\"})", "legendFormat": "unschedulable reasons", "refId": "B" }
      ],
      "title": "Scheduling pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Spring Boot Actuator request counter scraped from annotated backend Pods.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\"}[1m]))", "legendFormat": "backend request rate", "refId": "A" }
      ],
      "title": "Backend throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Spring Boot request histogram p95 from the backend scrape.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\"}[1m])))", "legendFormat": "backend p95", "refId": "A" }
      ],
      "title": "Backend latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "5xx ratio from the same backend request counter used for the SLO check.",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\"}[1m])),0.001)", "legendFormat": "5xx ratio", "refId": "A" }
      ],
      "title": "Backend 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Actuator process CPU is an application bottleneck signal, not node CPU utilization.",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "100 * avg(rate(process_cpu_seconds_total{app=\"travel-planner-backend\",environment=\"$environment\"}[1m]))", "legendFormat": "backend process CPU", "refId": "A" }
      ],
      "title": "Backend process CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Actuator JVM heap usage across backend Pods.",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{app=\"travel-planner-backend\",environment=\"$environment\",area=\"heap\"})", "legendFormat": "heap used", "refId": "A" }
      ],
      "title": "Backend JVM heap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Hikari active and pending connections expose a database-pool bottleneck.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(hikaricp_connections_active{app=\"travel-planner-backend\",environment=\"$environment\"})", "legendFormat": "active connections", "refId": "A" },
        { "expr": "sum(hikaricp_connections_pending{app=\"travel-planner-backend\",environment=\"$environment\"})", "legendFormat": "pending connections", "refId": "B" }
      ],
      "title": "Backend Hikari connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Restart, CrashLoopBackOff and OOMKilled signals for the Backend Pods.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",container=\"backend\"}[1m]))", "legendFormat": "restarts", "refId": "A" },
        { "expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"$namespace\",container=\"backend\",reason=\"CrashLoopBackOff\"})", "legendFormat": "CrashLoopBackOff", "refId": "B" },
        { "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\",container=\"backend\",reason=\"OOMKilled\"})", "legendFormat": "OOMKilled", "refId": "C" }
      ],
      "title": "Backend Pod health / restart / OOM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "ALB request, latency, healthy target and 5xx signals over the same one-minute window.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "LoadBalancer": "$alb_dimension" }, "expression": "", "matchExact": true, "metricName": "RequestCount", "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60", "queryMode": "Metrics", "refId": "A", "region": "ap-northeast-2", "statistic": "Sum" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "LoadBalancer": "$alb_dimension", "TargetGroup": "$target_group_dimension" }, "expression": "", "matchExact": true, "metricName": "TargetResponseTime", "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60", "queryMode": "Metrics", "refId": "B", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "LoadBalancer": "$alb_dimension", "TargetGroup": "$target_group_dimension" }, "expression": "", "matchExact": true, "metricName": "HealthyHostCount", "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60", "queryMode": "Metrics", "refId": "C", "region": "ap-northeast-2", "statistic": "Minimum" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "LoadBalancer": "$alb_dimension" }, "expression": "", "matchExact": true, "metricName": "HTTPCode_ELB_5XX_Count", "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60", "queryMode": "Metrics", "refId": "D", "region": "ap-northeast-2", "statistic": "Sum" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "LoadBalancer": "$alb_dimension", "TargetGroup": "$target_group_dimension" }, "expression": "", "matchExact": true, "metricName": "HTTPCode_Target_5XX_Count", "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60", "queryMode": "Metrics", "refId": "E", "region": "ap-northeast-2", "statistic": "Sum" }
      ],
      "title": "ALB request / target health / 5xx",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Backing managed node-group ASG desired, in-service and pending instances.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "id": 14,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "AutoScalingGroupName": "$autoscaling_group_name" }, "expression": "", "matchExact": true, "metricName": "GroupDesiredCapacity", "metricQueryType": 0, "namespace": "AWS/AutoScaling", "period": "60", "queryMode": "Metrics", "refId": "A", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "AutoScalingGroupName": "$autoscaling_group_name" }, "expression": "", "matchExact": true, "metricName": "GroupInServiceInstances", "metricQueryType": 0, "namespace": "AWS/AutoScaling", "period": "60", "queryMode": "Metrics", "refId": "B", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "AutoScalingGroupName": "$autoscaling_group_name" }, "expression": "", "matchExact": true, "metricName": "GroupPendingInstances", "metricQueryType": 0, "namespace": "AWS/AutoScaling", "period": "60", "queryMode": "Metrics", "refId": "C", "region": "ap-northeast-2", "statistic": "Average" }
      ],
      "title": "EKS node-group / ASG capacity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "RDS and Redis pressure signals used to attribute a data-tier breakpoint.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "id": 15,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "DBInstanceIdentifier": "$db_instance_identifier" }, "expression": "", "matchExact": true, "metricName": "CPUUtilization", "metricQueryType": 0, "namespace": "AWS/RDS", "period": "60", "queryMode": "Metrics", "refId": "A", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "DBInstanceIdentifier": "$db_instance_identifier" }, "expression": "", "matchExact": true, "metricName": "DatabaseConnections", "metricQueryType": 0, "namespace": "AWS/RDS", "period": "60", "queryMode": "Metrics", "refId": "B", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "CacheClusterId": "$cache_cluster_id" }, "expression": "", "matchExact": true, "metricName": "EngineCPUUtilization", "metricQueryType": 0, "namespace": "AWS/ElastiCache", "period": "60", "queryMode": "Metrics", "refId": "C", "region": "ap-northeast-2", "statistic": "Average" },
        { "datasource": { "type": "cloudwatch", "uid": "cloudwatch" }, "dimensions": { "CacheClusterId": "$cache_cluster_id" }, "expression": "", "matchExact": true, "metricName": "Evictions", "metricQueryType": 0, "namespace": "AWS/ElastiCache", "period": "60", "queryMode": "Metrics", "refId": "D", "region": "ap-northeast-2", "statistic": "Sum" }
      ],
      "title": "RDS / Redis pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend request rate grouped by bounded route families. The grouping is a URI-to-feature-family view of the frozen 26-operation workload; no user, travel or request identifiers are labels.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 64 },
      "id": 16,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/auth/.*\"}[1m]))", "legendFormat": "auth-control", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/profile$\"}[1m]))", "legendFormat": "profile", "refId": "B" },
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/travels/.*\"}[1m]))", "legendFormat": "travel", "refId": "C" },
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/(countries|places)/.*\"}[1m]))", "legendFormat": "location / places", "refId": "D" },
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/travel-invitations$\"}[1m]))", "legendFormat": "membership", "refId": "E" },
        { "expr": "sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/community/.*\"}[1m]))", "legendFormat": "community", "refId": "F" }
      ],
      "title": "Backend request rate by feature family",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend p95 latency by the same bounded URI families used by the request-rate panel.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 74 },
      "id": 17,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/auth/.*\"}[1m])))", "legendFormat": "auth-control", "refId": "A" },
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/profile$\"}[1m])))", "legendFormat": "profile", "refId": "B" },
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/travels/.*\"}[1m])))", "legendFormat": "travel", "refId": "C" },
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/(countries|places)/.*\"}[1m])))", "legendFormat": "location / places", "refId": "D" },
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/travel-invitations$\"}[1m])))", "legendFormat": "membership", "refId": "E" },
        { "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/community/.*\"}[1m])))", "legendFormat": "community", "refId": "F" }
      ],
      "title": "Backend p95 by feature family",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend 5xx percentage by bounded URI family; an empty low-volume family is kept distinct from zero by the fixed-range exporter.",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 84 },
      "id": 18,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/auth/.*\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/auth/.*\"}[1m])),0.001)", "legendFormat": "auth-control", "refId": "A" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/profile$\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/profile$\"}[1m])),0.001)", "legendFormat": "profile", "refId": "B" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/travels/.*\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/travels/.*\"}[1m])),0.001)", "legendFormat": "travel", "refId": "C" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/(countries|places)/.*\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/(countries|places)/.*\"}[1m])),0.001)", "legendFormat": "location / places", "refId": "D" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/travel-invitations$\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"travel-planner-backend\",environment=\"$environment\",uri=~\"^/api/v1/users/me/travel-invitations$\"}[1m])),0.001)", "legendFormat": "membership", "refId": "E" },
