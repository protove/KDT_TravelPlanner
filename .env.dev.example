COMPOSE_PROJECT_NAME=travel-diary-dev

FRONTEND_PORT=3000
BACKEND_PORT=8080
MANAGEMENT_PORT=9091
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-dev-grafana-password
STORYBOOK_PORT=6006

POSTGRES_DB=travel_diary_dev
