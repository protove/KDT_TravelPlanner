# Local production-image simulation only. Do not use these values in a real deployment.
COMPOSE_PROJECT_NAME=travel-diary-prod

FRONTEND_PORT=3000
BACKEND_PORT=8080
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-admin-password

POSTGRES_DB=travel_diary_prod
POSTGRES_USER=travel_diary_prod
POSTGRES_PASSWORD=travel_diary_prod_password
REDIS_PASSWORD=travel_diary_prod_redis_password

SPRING_PROFILES_ACTIVE=prod
INTERNAL_API_BASE_URL=http://backend:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_HTTP_CONNECT_TIMEOUT=3s
OAUTH_HTTP_READ_TIMEOUT=5s
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/naver/callback

# Google Maps Platform backend key. Replace with a production-only key in a real deployment.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_CONNECT_TIMEOUT=2s
GOOGLE_PLACES_READ_TIMEOUT=3s
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_CONNECT_TIMEOUT=2s
GOOGLE_ROUTES_READ_TIMEOUT=5s

# 프로필 이미지 저장소 (S3 + CloudFront). 운영 배포 시 별도 prod 버킷 필요 — 아직 미생성
PROFILE_IMAGE_STORAGE_ENABLED=true
PROFILE_IMAGE_STORAGE_REGION=ap-northeast-2
PROFILE_IMAGE_STORAGE_ACCESS_KEY=
PROFILE_IMAGE_STORAGE_SECRET_KEY=
PROFILE_IMAGE_STORAGE_BUCKET=
PROFILE_IMAGE_PUBLIC_BASE_URL=