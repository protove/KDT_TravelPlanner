{
  "profileVersion": "aws-eks-monolith-breakpoint-v1.0",
  "scenarioId": "SCRUM-77-EKS-MONOLITH-BREAKPOINT",
  "environment": "dev-eks",
  "region": "ap-northeast-2",
  "target": {
    "platform": "eks",
    "baseUrl": "https://REPLACE_WITH_APPROVED_EKS_ALB_HOSTNAME",
    "note": "실행 직전 승인된 EKS ALB HTTPS 주소를 입력한다."
  },
  "googleApi": { "enabled": false },
  "sloVersion": "v1.1-candidate",
  "seedVersion": "s2",
  "requestMixVersion": "aws-ec2-eks-comparison-v1.1",
  "k6Image": "REPLACE_WITH_DIGEST_PINNED_K6_IMAGE",
  "limits": {
    "maxRate": 256,
    "maxVUs": 512,
    "maxDurationSeconds": 1200
  },
  "eks": {
    "instanceType": "t3.small",
    "nodeGroup": { "min": 2, "desired": 2, "max": 4 },
    "baseHpa": { "minReplicas": 2, "maxReplicas": 4 },
    "capacityMethod": "allocatable-request-conservative"
  },
  "capacityStress": {
    "bindsTo": {
      "normalRate": "eks-monolith-breakpoint-slo-v1.0.comparison.normalRate",
      "sloContract": "load-tests/aws/contracts/eks-monolith-breakpoint-slo-v1.0.json",
      "requestMix": "aws-ec2-eks-comparison-v1.1",
      "lineage": "frozen-normal-image-and-seed-lineage"
    },
    "stageMultipliers": [1, 2, 4, 8, 16],
    "stageDurations": ["3m", "3m", "3m", "3m", "3m"],
    "stageGraceSeconds": 60,
    "capacityStabilitySeconds": 120,
    "hardTimeCeilingSeconds": 1020,
    "preAllocatedVUs": 128,
    "maxVUs": 512,
    "seededUsers": 512,
    "runnerDefaultInstanceType": "t3.small",
    "runnerRepairInstanceType": "t3.medium",
    "runnerRepairLimit": 1,
    "requiresCompleteSloWindows": true,
    "terminalConditions": [
      "NODE_MAX_PENDING",
      "SLO_COLLAPSE",
      "DATA_TIER_SATURATION",
      "MAX_CAPACITY_REACHED",
      "PROFILE_COMPLETE",
      "HARD_CEILING"
    ]
  },
  "scenarios": {
    "smoke": { "vus": 2, "iterations": 1, "maxDuration": "2m" },
    "ramp": {
      "executor": "ramping-arrival-rate",
      "startRate": 1,
      "timeUnit": "1s",
      "preAllocatedVUs": 20,
      "maxVUs": 80,
      "stages": [
        { "targetRate": 4, "duration": "2m" },
        { "targetRate": 8, "duration": "2m" },
        { "targetRate": 16, "duration": "2m" },
        { "targetRate": 32, "duration": "2m" },
        { "targetRate": 64, "duration": "2m" }
      ]
    },
    "baseline": {
      "executor": "constant-arrival-rate",
      "rate": null,
      "timeUnit": "1s",
      "warmup": "3m",
      "duration": "10m",
      "preAllocatedVUs": 20,
      "maxVUs": 20,
      "repeat": 3
    },
    "spike": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "peakRateMultiplier": 3,
      "hold": "1m",
      "preAllocatedVUs": 20,
      "maxVUs": 80
    },
    "soak": {
      "executor": "constant-arrival-rate",
      "rate": null,
      "timeUnit": "1s",
      "warmup": "3m",
      "duration": "30m",
      "preAllocatedVUs": 20,
      "maxVUs": 80
    },
    "scale-step": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "timeUnit": "1s",
      "preAllocatedVUs": 20,
      "maxVUs": 80,
      "stages": [
        { "targetRate": 8, "duration": "5m" },
        { "targetRate": 16, "duration": "5m" },
        { "targetRate": 32, "duration": "5m" }
      ]
    },
    "capacity-stress": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "timeUnit": "1s",
      "preAllocatedVUs": 128,
      "maxVUs": 512,
      "stageMultipliers": [1, 2, 4, 8, 16],
      "stageDurations": ["3m", "3m", "3m", "3m", "3m"]
    }
  },
  "requestMix": {
    "normal": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 },
    "baseline": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 },
    "spike": { "refresh": 15, "travelList": 30, "travelDetail": 18, "mapPoints": 15, "timelineCreate": 14, "orderChange": 8 },
    "soak": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 }
  }
}
