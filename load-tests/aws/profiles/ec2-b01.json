{
  "profileVersion": "aws-b01-v1",
  "scenarioId": "B-01",
  "environment": "dev-runtime",
  "region": "ap-northeast-2",
  "sloVersion": "v0.2-candidate",
  "seedVersion": "s2",
  "requestMixVersion": "aws-b01-v1",

  "target": {
    "baseUrl": "https://REPLACE_WITH_APPROVED_ALB_HOSTNAME",
    "note": "운영자가 실행 직전 승인된 ALB HTTPS 주소로 교체하거나 BASE_URL 환경변수로 덮어쓴다. REPLACE_ 문자열이 남아있으면 검증에서 거부된다."
  },

  "googleApi": {
    "enabled": false,
    "note": "실제 Google Places/Routes 호출은 항상 비활성화한다."
  },

  "k6Image": "REPLACE_WITH_DIGEST_PINNED_K6_IMAGE",

  "limits": {
    "maxRate": 30,
    "maxVUs": 100,
    "note": "orchestration 스크립트가 이 값을 초과하는 rate/VU 요청을 거부한다. D-005 확정 전까지의 임시 상한."
  },

  "scenarios": {
    "smoke": {
      "vus": 2,
      "iterations": 1,
      "maxDuration": "2m"
    },
    "ramp": {
      "executor": "ramping-arrival-rate",
      "startRate": 1,
      "timeUnit": "1s",
      "preAllocatedVUs": 20,
      "maxVUs": 60,
      "stages": [
        { "targetRate": 4, "duration": "2m" },
        { "targetRate": 8, "duration": "2m" },
        { "targetRate": 12, "duration": "2m" },
        { "targetRate": 16, "duration": "2m" },
        { "targetRate": 20, "duration": "2m" }
      ],
      "note": "최대 안정 RPS 후보(D-005)를 찾기 위한 단계적 증가. 후보 확정 후 baseline.rate에 반영한다."
    },
    "baseline": {
      "executor": "constant-arrival-rate",
      "rate": null,
      "timeUnit": "1s",
      "warmup": "3m",
      "duration": "10m",
      "preAllocatedVUs": 20,
      "maxVUs": 20,
      "repeat": 3,
      "note": "rate는 D-005(정상 arrival-rate)가 Ramp 결과로 확정되기 전까지 null이며, 값 없이는 실행을 거부한다."
    },
    "spike": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "peakRateMultiplier": 3,
      "hold": "1m",
      "preAllocatedVUs": 20,
      "maxVUs": 80,
      "note": "startRate는 baseline.rate 확정 값을 그대로 사용한다."
    }
  },

  "requestMix": {
    "baseline": {
      "refresh": 12,
      "travelList": 22,
      "travelDetail": 20,
      "mapPoints": 18,
      "timelineCreate": 18,
      "orderChange": 10
    },
    "spike": {
      "refresh": 15,
      "travelList": 40,
      "travelDetail": 25,
      "mapPoints": 20
    }
  }
}
