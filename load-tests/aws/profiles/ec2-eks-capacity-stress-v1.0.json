{
  "profileVersion": "aws-ec2-eks-capacity-stress-v1.0",
  "scenarioId": "SCRUM-43-CAPACITY-STRESS",
  "environment": "comparison",
  "region": "ap-northeast-2",
  "sloVersion": "v1.1-frozen",
  "seedVersion": "s2",
  "requestMixVersion": "aws-ec2-eks-comparison-v1.1",
  "target": {
    "baseUrl": "https://REPLACE_WITH_APPROVED_ALB_HOSTNAME",
    "note": "운영자가 실행 직전 승인된 플랫폼의 ALB HTTPS 주소로 입력한다."
  },
  "googleApi": { "enabled": false },
  "k6Image": "REPLACE_WITH_DIGEST_PINNED_K6_IMAGE",
  "limits": {
    "maxRate": 256,
    "maxVUs": 320,
    "maxDurationSeconds": 28800
  },
  "capacityStress": {
    "bindsTo": {
      "normalRate": "slo-v1.1-frozen.comparison.normalRate",
      "sloContract": "load-tests/aws/contracts/slo-v1.1-frozen.json",
      "requestMix": "aws-ec2-eks-comparison-v1.1",
      "lineage": "frozen-normal-image-and-seed-lineage"
    },
    "stageMultipliers": [1, 2, 4, 8],
    "stageDurations": ["5m", "8m", "8m", "8m"],
    "stageGraceSeconds": 60,
    "capacityStabilitySeconds": 120,
    "scaleInObservationSeconds": 600,
    "hardTimeCeilingSeconds": 2100,
    "preAllocatedVUs": 100,
    "maxVUs": 320,
    "seededUsers": 320,
    "runnerDefaultInstanceType": "t3.small",
    "runnerRepairInstanceType": "t3.medium",
    "runnerRepairLimit": 1
  },
  "scenarios": {
    "smoke": { "vus": 2, "iterations": 1, "maxDuration": "2m" },
    "ramp": {
      "executor": "ramping-arrival-rate",
      "startRate": 1,
      "timeUnit": "1s",
      "preAllocatedVUs": 20,
      "maxVUs": 60,
      "stages": [
        { "targetRate": 4, "duration": "2m" },
        { "targetRate": 8, "duration": "2m" },
        { "targetRate": 12, "duration": "2m" },
        { "targetRate": 16, "duration": "2m" },
        { "targetRate": 20, "duration": "2m" }
      ]
    },
    "baseline": {
      "executor": "constant-arrival-rate",
      "rate": null,
      "timeUnit": "1s",
      "warmup": "3m",
      "duration": "10m",
      "preAllocatedVUs": 20,
      "maxVUs": 20,
      "repeat": 3
    },
    "spike": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "peakRateMultiplier": 3,
      "hold": "1m",
      "preAllocatedVUs": 20,
      "maxVUs": 80
    },
    "soak": {
      "executor": "constant-arrival-rate",
      "rate": null,
      "timeUnit": "1s",
      "warmup": "3m",
      "duration": "30m",
      "preAllocatedVUs": 20,
      "maxVUs": 60
    },
    "scale-step": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "timeUnit": "1s",
      "preAllocatedVUs": 20,
      "maxVUs": 80,
      "stages": [
        { "targetRate": 8, "duration": "5m" },
        { "targetRate": 12, "duration": "5m" },
        { "targetRate": 16, "duration": "5m" }
      ]
    },
    "capacity-stress": {
      "executor": "ramping-arrival-rate",
      "startRate": null,
      "timeUnit": "1s",
      "preAllocatedVUs": 100,
      "maxVUs": 320,
      "stageMultipliers": [1, 2, 4, 8],
      "stageDurations": ["5m", "8m", "8m", "8m"]
    }
  },
  "requestMix": {
    "normal": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 },
    "baseline": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 },
    "spike": { "refresh": 15, "travelList": 30, "travelDetail": 18, "mapPoints": 15, "timelineCreate": 14, "orderChange": 8 },
    "soak": { "refresh": 12, "travelList": 22, "travelDetail": 20, "mapPoints": 18, "timelineCreate": 18, "orderChange": 10 }
  }
}
