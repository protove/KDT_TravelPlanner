{
  "contractVersion": "aws-recovery-fault-image-v1",
  "artifactKind": "test-only-backend-fault-fixture",
  "image": {
    "deploymentReference": "RECOVERY_FAULT_IMAGE_DIGEST",
    "requiresDigest": true,
    "digestPattern": "^[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$",
    "baseImageRequiresDigest": true,
    "baseImagePattern": "^python:3\\.12-alpine@sha256:[0-9a-f]{64}$"
  },
  "metadata": {
    "fileName": "artifact-metadata.json",
    "requiredFields": [
      "contractVersion",
      "imageRef",
      "baseImage",
      "mode",
      "faultPath",
      "faultErrorCode",
      "faultErrorMessage",
      "faultHttpStatus"
    ],
    "faultParameters": {
      "faultPath": {
        "default": "/api/v1/travels",
        "pattern": "^/api/v1/[A-Za-z0-9_./{}:-]+$"
      },
      "faultErrorCode": {
        "default": "INTERNAL_SERVER_ERROR",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      },
      "faultErrorMessage": {
        "default": "서버 내부 오류가 발생했습니다.",
        "maxLength": 256
      },
      "faultHttpStatus": {
        "default": 500,
        "minimum": 500,
        "maximum": 599
      }
    }
  },
  "ports": {
    "application": 8080,
    "management": 9091,
    "readinessPath": "/actuator/health/readiness",
    "livenessPath": "/actuator/health/liveness"
  },
  "modes": {
    "normal": {
      "readinessStatus": 200,
      "coreApiStatus": 200
    },
    "probe_failure": {
      "readinessStatus": 503,
      "livenessStatus": 200,
      "coreApiStatus": 200,
      "purpose": "readiness failure while process and application port remain reachable"
    },
    "business_error": {
      "readinessStatus": 200,
      "livenessStatus": 200,
      "coreApiStatus": 500,
      "errorEnvelope": {
        "requiredFields": ["code", "message", "requestId"],
        "defaultCode": "INTERNAL_SERVER_ERROR"
      },
      "purpose": "readiness succeeds but the registered core API path returns a deterministic error"
    }
  },
  "safety": {
    "usesDatabase": false,
    "usesRedis": false,
    "usesAws": false,
    "usesGoogleApis": false,
    "readsSecrets": false,
    "productionBackendChanges": false,
    "defaultFaultPath": "/api/v1/travels",
    "defaultFaultStatus": 500
  }
}
