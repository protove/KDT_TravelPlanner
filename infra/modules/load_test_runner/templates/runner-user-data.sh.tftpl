#!/usr/bin/env bash
set -euo pipefail

# cloud-init prepares only the private Runner base.  Source, k6 and the
# Google API mock arrive later through the operator's run-scoped S3 + SSM
# bootstrap; this keeps an unauthenticated/public GitHub assumption out of
# the instance lifecycle and makes full readiness an explicit evidence gate.
dnf install -y docker git python3-pip curl tar gzip
systemctl enable --now docker

command -v aws >/dev/null 2>&1 || {
  echo "AWS CLI is required on the Load Runner base image" >&2
  exit 1
}
command -v docker >/dev/null 2>&1 || {
  echo "Docker is required on the Load Runner base image" >&2
  exit 1
}
aws --version >/dev/null 2>&1
docker info >/dev/null 2>&1

install -d -m 0755 /opt
install -d -m 0700 /var/lib/travel-planner/load-test-evidence
install -d -m 0700 /etc/travel-planner

# This receipt proves only cloud-init/base setup.  It deliberately does not
# claim that the reviewed source, pinned images or private mock are ready.
base_receipt_tmp="/var/lib/travel-planner/load-test-evidence/.base-ready.json.tmp"
python3 - "$base_receipt_tmp" '${aws_region}' '${source_commit_sha}' <<'PY'
import json
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path

output, region, source_sha = sys.argv[1:]
Path(output).write_text(json.dumps({
    "schemaVersion": "scrum80-runner-base-ready/v1",
    "status": "base-ready",
    "region": region,
    "sourceCommitShaExpected": source_sha,
    "dockerActive": True,
    "awsCliAvailable": shutil.which("aws") is not None,
    "gitAvailable": shutil.which("git") is not None,
    "pythonAvailable": shutil.which("python3") is not None,
    "freeBytesOpt": shutil.disk_usage("/opt").free,
    "recordedAtUtc": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
}, sort_keys=True) + "\n", encoding="utf-8")
PY
chmod 0600 "$base_receipt_tmp"
mv -f "$base_receipt_tmp" /var/lib/travel-planner/load-test-evidence/base-ready.json

printf 'AWS_DEFAULT_REGION=%s\nLOAD_TEST_SOURCE_REF=%s\n' \
  '${aws_region}' '${source_commit_sha}' > /etc/travel-planner/load-runner.env
chmod 0600 /etc/travel-planner/load-runner.env
