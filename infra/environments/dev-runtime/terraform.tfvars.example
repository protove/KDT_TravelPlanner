aws_account_id         = "123456789012"
aws_region             = "ap-northeast-2"
project_name           = "kdt-travelplanner"
persistent_state_bucket = "kdt-travelplanner-tfstate-123456789012-ap-northeast-2"

# Query the latest PostgreSQL 17 patch in ap-northeast-2 immediately before the operator plan.
postgres_engine_version = "17.8"

# Tags are rejected. Replace this example digest with an image that exists in the persistent dev ECR repository.
backend_image_uri = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kdt-travelplanner-dev-backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# EC2 comparison seed. Keep 300 seconds for the first calibration; replace
# only after observing ASG InService -> ALB healthy readiness on the live run.
backend_health_check_grace_period_seconds = 300

# Rollout contract defaults. Keep NORMAL values for the ordinary dev-runtime
# baseline. Recovery experiments must set all fields together in a separate,
# uniquely named tfvars/plan file; never edit a previously approved plan.
backend_rollout_mode                   = "NORMAL"
backend_rollout_min_healthy_percentage = 100
backend_rollout_max_healthy_percentage = 200
backend_rollout_checkpoint_percentages = []
backend_rollout_checkpoint_delay_seconds = 60
backend_rollout_scaling_policy_enabled = true
# Changing only this marker creates a new numbered Launch Template version and
# a real Instance Refresh with the same digest (R-01). Use a unique value per
# experiment run, e.g. "r01-<run-id>".
backend_rollout_revision = "baseline"
# backend_rollout_normal_image_uri  = "...@sha256:<previous-normal-digest>"
# backend_rollout_fault_image_uri   = "...@sha256:<fault-digest>"
# backend_rollout_restore_image_uri = "...@sha256:<previous-normal-digest>"
